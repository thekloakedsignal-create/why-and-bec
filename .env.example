# Session cookie signing secret (any long random string)
SESSION_SECRET=

# X (Twitter) OAuth 2.0 app credentials — create at developer.x.com
X_CLIENT_ID=
X_CLIENT_SECRET=
# Must exactly match the callback URL registered in your X app
X_CALLBACK_URL=

# Optional: xAI (Grok) API key for the "Inspire me" button.
# Leave empty = game works fully without AI.
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# Set to "true" only if you want dev login available while X login is configured
ALLOW_DEV_LOGIN=